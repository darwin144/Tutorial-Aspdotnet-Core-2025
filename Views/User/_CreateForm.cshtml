@model UserVM

<div class="mb-3">
    <label for="Nama" class="form-label">Nama</label>
    <input type="text" class="form-control" id="Nama" name="Nama" value="@Model.Username" required />
</div>
<div class="mb-3">
    <label for="Email" class="form-label">Email</label>
    <input type="email" class="form-control" id="Email" name="Email" value="@Model.Password" required />
</div>
