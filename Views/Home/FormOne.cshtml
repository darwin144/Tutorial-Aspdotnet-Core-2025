@model GArch_Web.Models.UserVM

<script src="https://unpkg.com/sweetalert/dist/sweetalert.min.js"></script>
<link href="~/css/site.css" rel="stylesheet" />


<form id="FormOne">
    <div class="form-group">
        <label>Username</label>
        @Html.TextBoxFor(m => m.Username, new { @class = "form-control", @data_required = "true", @data_name = "Username" })
    </div>

    <div class="form-group">
        <label>Password</label>
        @Html.TextBoxFor(m => m.Password, new { @class = "form-control", @data_required = "true", @data_name = "Password" })
    </div>

    <div class="row m-2">
        <a class="btn btn-secondary" style="width:80px;" onclick="triggerBtn()" id="BtnTrigger">Trigger</a>
    </div>
    <div class="row mt-2">
        <a class="btn btn-primary disabled" style="width:80px;" onclick="submitForm()" id="BtnSubmit">Submit</a>
    </div>
</form>

<script src="~/js/validator.js"></script>
